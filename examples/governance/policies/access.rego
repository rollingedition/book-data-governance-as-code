# Who may read which of the platform's tables, which rows, and how each column is shown.
#
# Input: a request shaped like Trino's OPA requests, so the same policy can serve Trino:
#   context.identity.user                  who is asking (a key of data.platform.users)
#   action.operation                       "SelectFromColumns"
#   action.resource.table.schemaName       the table's namespace, such as "crm"
#   action.resource.table.tableName        the table's name, such as "learners"
#   action.resource.table.columns          the columns the query reads
#   purpose                                optional: why, such as "ai-training"
# Data, generated by lib/policy.py, never typed:
#   data.platform.users                    each user's groups and attributes (governance/users.toml)
#   data.platform.classifications          each table's columns and their classification (governance/metadata.toml)
#   data.platform.instructor_courses       each instructor's course IDs (learning.courses)
#
# Output: data.platform.access.decision, one document: allow, row filters, column masks and the reasons.
# Row filters and masks are data, never SQL, so nothing a request carries can reach a query as code.
package platform.access

import rego.v1

user := data.platform.users[input.context.identity.user]

groups := {group | some group in user.groups}

table := sprintf("%s.%s", [input.action.resource.table.schemaName, input.action.resource.table.tableName])

requested := {column | some column in input.action.resource.table.columns}

# A column the metadata doesn't classify is treated as sensitive until someone classifies it.
classification(column) := level if {
	level := data.platform.classifications[table][column]
} else := "sensitive"

# --- Which groups may read which tables --------------------------------------------------------------------------

readable := {
	"support": {"crm.learners", "support.tickets"},
	"instructor": {"learning.courses", "learning.enrollments", "learning.reviews"},
	"marketing": {"crm.learners", "learning.courses", "marketing.audience"},
	"finance": {"billing.payments", "learning.courses", "learning.enrollments"},
	"data-science": {
		"crm.learners", "learning.courses", "learning.enrollments", "learning.events", "learning.reviews",
		"billing.payments", "analytics.course_performance", "analytics.learner_activity",
	},
	"ai": {"learning.courses", "learning.reviews"},
}

default allow := false

allow if {
	input.action.operation == "SelectFromColumns"
	readable_by_a_group
	not missing_attribute
}

readable_by_a_group if {
	some group in groups
	table in readable[group]
}

# Every attribute a group's row filters depend on must be there: a filter on a missing value would quietly not apply.
missing_attribute if count(missing_attributes) > 0

missing_attributes contains "support's row filter needs the user's region, and there is none" if {
	"support" in groups
	not user.region
}

missing_attributes contains "instructor's row filter needs the user's courses, and there are none" if {
	"instructor" in groups
	not data.platform.instructor_courses[sprintf("%d", [user.instructor_id])]
}

# --- Which rows -------------------------------------------------------------------------------------------------

row_filters contains {"column": "support_region", "equals": user.region} if {
	"support" in groups
	table in {"crm.learners", "support.tickets"}
}

row_filters contains {"column": "course_id", "in": data.platform.instructor_courses[sprintf("%d", [user.instructor_id])]} if {
	"instructor" in groups
	table in {"learning.courses", "learning.enrollments", "learning.reviews"}
}

row_filters contains {"column": "marketing_consent", "equals": true} if {
	"marketing" in groups
	table == "crm.learners"
}

row_filters contains {"column": "status", "equals": "active"} if {
	"marketing" in groups
	table == "crm.learners"
}

# Reading to train the platform's AI, by the assistant or by anyone who gives that purpose, sees only the reviews whose
# authors agreed to it: a filter on the learner, not the review.
row_filters contains {"learner_consented": "ai_training_consent"} if {
	ai_training
	table == "learning.reviews"
}

ai_training if "ai" in groups

ai_training if input.purpose == "ai-training"

# --- How each column is shown -------------------------------------------------------------------------------------

free_text := {"body", "notes"}

# Sensitive columns: hidden from everyone, except the last four digits of a card number for finance.
column_masks[column] := "last4" if {
	some column in requested
	classification(column) == "sensitive"
	column == "card_number"
	"finance" in groups
}

column_masks[column] := "redact" if {
	some column in requested
	classification(column) == "sensitive"
	not finance_card(column)
}

finance_card(column) if {
	column == "card_number"
	"finance" in groups
}

# Personal columns: support sees them; everyone else sees what their job needs, and nothing more.
column_masks[column] := mask if {
	some column in requested
	classification(column) == "personal"
	not "support" in groups
	mask := personal_mask(column)
	mask != "show"
}

personal_mask(column) := "redact_contacts" if {
	column == "body"
	reads_review_text
} else := "pseudonymize" if {
	not column in free_text
	"data-science" in groups
} else := "show" if {
	column in {"full_name", "email"}
	"marketing" in groups
} else := "redact"

# Instructors, and anyone training the AI, read review text for what it says: with contact details taken out.
# Without a purpose, a data scientist sees no review text at all, so a purpose left out can only hide more.
reads_review_text if count({"instructor", "ai"} & groups) > 0

reads_review_text if ai_training

# --- The decision -------------------------------------------------------------------------------------------------

reasons contains sprintf("%s may read %s", [group, table]) if {
	allow
	some group in groups
	table in readable[group]
}

reasons contains "no group of this user may read this table" if {
	not allow
	not readable_by_a_group
}

reasons contains sprintf("%s is not an operation this policy allows", [input.action.operation]) if {
	input.action.operation != "SelectFromColumns"
}

reasons contains missing if some missing in missing_attributes

reasons contains sprintf("%s is %s, shown as %s", [column, classification(column), mask]) if {
	allow
	some column, mask in column_masks
}

# Two rules, so a denial carries no filters or masks that anything downstream could mistake for a filtered read.
decision := {
	"allow": true,
	"row_filters": [filter | some filter in row_filters],
	"column_masks": column_masks,
	"reasons": sort([reason | some reason in reasons]),
} if allow

decision := {
	"allow": false,
	"row_filters": [],
	"column_masks": {},
	"reasons": sort([reason | some reason in reasons]),
} if not allow
