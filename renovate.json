{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Generated by re-check readme from the standards' data/renovate.json, the same for every book. Don't edit by hand.",
  "extends": ["config:recommended"],
  "enabledManagers": ["pip_requirements", "pyenv"],
  "ignorePaths": [],
  "includePaths": ["examples/requirements.txt", "examples/.python-version"],
  "dependencyDashboard": false,
  "pip_requirements": {
    "managerFilePatterns": ["/^examples/requirements\\.txt$/"]
  },
  "pyenv": {
    "managerFilePatterns": ["/^examples/\\.python-version$/"]
  },
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "labels": ["kind:deps"],
  "packageRules": [
    {
      "description": "A new major version of a pinned library is a breaking change and starts a new edition line",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking"]
    }
  ]
}
